# ---------------------------------------------------------------------------
# StrongSense Coach API - environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` (same directory) and fill in your own values:
#     Copy-Item .env.example .env        # PowerShell
#     cp .env.example .env               # bash
# or run:  powershell -ExecutionPolicy Bypass -File ../../scripts/set_keys.ps1
#
# Never commit `.env`. The repository `.gitignore` already excludes it and CI fails
# if a tracked `.env` or key file is found. This file contains placeholders only.
# ---------------------------------------------------------------------------

# Environment label. Use "production" for deployments, "development" locally.
APP_ENV=development

# Interface/port used when you start `python -m app.main` (uvicorn CLI users pass
# --host/--port explicitly instead). The Docker image listens on 0.0.0.0:8080.
COACH_HOST=127.0.0.1
COACH_PORT=8080

# Optional bearer token required by POST /v1/coach/plan. Leave empty to disable
# authentication (local development only!). The Flutter app sends this as
# `Authorization: Bearer <token>`. Generate one with, e.g., `openssl rand -hex 32`.
COACH_API_TOKEN=

# Comma separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-client request budget for POST /v1/coach/plan. 0 disables rate limiting.
MAX_REQUESTS_PER_MIN=30

# ---------------------------------------------------------------------------
# Primary LLM provider
# ---------------------------------------------------------------------------
# LLM_PROVIDER is either:
#   openai_compatible  -> POST {LLM_BASE_URL}/chat/completions
#   anthropic          -> POST {LLM_BASE_URL}/v1/messages
# Leave LLM_PROVIDER empty to run without AI: /health reports llmConfigured=false
# and POST /v1/coach/plan returns 503 llm_not_configured (the app keeps using its
# deterministic offline coach).
LLM_PROVIDER=openai_compatible

# Base URL examples - uncomment/copy the one you use:
# OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4.1-mini
# Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# Gemini (OpenAI-compatible endpoint)
# Use the lite variant for this JSON task: full "flash" models think first and can
# spend the whole token budget on hidden reasoning (slow, and truncated JSON at 900).
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash-lite
# Ollama (local, no API key required)
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.1:8b
# Anthropic native API (set LLM_PROVIDER=anthropic and use the root URL)
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-3-5-haiku-latest

# API key for the primary provider. For Ollama or another local gateway without
# auth you may leave this empty. NEVER commit a real key.
LLM_API_KEY=

# Request timeout in seconds for the whole coaching call (primary + fallback).
LLM_TIMEOUT_SECONDS=20

# Sampling temperature and response token budget.
LLM_TEMPERATURE=0.4
# Reasoning models count hidden thinking tokens against this cap; 4096 leaves room for
# both the thinking budget and the JSON answer.
LLM_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Optional fallback provider (same shape as the primary block)
# ---------------------------------------------------------------------------
# When the primary provider fails (429/5xx/timeout/invalid JSON) the service tries
# the fallback once before returning 503 or the deterministic rules fallback.
# Commented out by default: leave empty to disable.
# LLM_FALLBACK_PROVIDER=openai_compatible
# LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=deepseek-chat
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# ---------------------------------------------------------------------------
# Optional PostgreSQL plan cache
# ---------------------------------------------------------------------------
# Set DATABASE_URL to a PostgreSQL instance to enable server-side caching of
# coaching responses. Leave empty to use the in-memory cache (default).
# Example: postgresql://user:pass@localhost:5432/strongsense
DATABASE_URL=
# How long a cached plan is kept, in seconds. Default 86400 (24 hours).
# Set 0 to disable expiry. Cached responses contain training context, so secure
# the database and restrict network access when enabling this.
CACHE_TTL_SECONDS=86400
